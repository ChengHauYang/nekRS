userSections = CASEDATA

[GENERAL]
polynomialOrder = 5
stopAt = endTime
endTime = 50.0
dt = 2e-3
timeStepper = tombo3
checkpointControl = simulationTime
checkpointInterval = 1.0

[PROBLEMTYPE]
equation = navierStokes

[FLUID PRESSURE]
residualTol = 1e-08
solver = cg+flexible
smootherType = Jac+Cheby
initialGuess = previous

[FLUID VELOCITY]
boundaryTypeMap = udfDirichlet, zeroNeumann
residualTol = 1e-10
rho = 1.0
viscosity = 0.01

[CASEDATA]
stl_file = geometry/cylinder.stl
marker_spacing = 0.14
shell_thickness = 0.125
support_radius = 0.30
gaussian_width = 0.15
max_subdivision_depth = 30
periodic_dimensions = z
free_stream_velocity = 1.0
cylinder_diameter = 1.0
span_length = 1.0

#include "opSEM.hpp"

#ifdef __okl__

void udfDirichlet(bcData * bc)
{
  if (isField("FLUID VELOCITY"))
  {
    bc->uxFluid = 0.0;
    bc->uyFluid = 0.0;
    bc->uzFluid = 0.0;
  }
}

#include "ibm/ibmKernels.okl"

#else

#include "ibm/staticSurfaceIBM.hpp"

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <string>

namespace
{
ibm::StaticSurfaceIBM staticIbm;
}

void ibmForcing(double time)
{
  staticIbm.applyForcing(time);
}

void UDF_Setup0(MPI_Comm, setupAide & options)
{
  staticIbm.configure(options);
}

void UDF_Setup()
{
  staticIbm.setup(nrs);
  if (staticIbm.hasElementClassification())
    nrs->addUserCheckpointField("scalar00", {staticIbm.elementRegionField()});
  nrs->userSource = &ibmForcing;
}

void UDF_LoadKernels(deviceKernelProperties & kernelInfo)
{
  kernelInfo.define("p_blockSize") = 256;
}

void UDF_ExecuteStep(double time, int tstep)
{
  if (!nrs->lastStep)
    return;

  const auto values = staticIbm.diagnostics();
  if (platform->comm.mpiRank() == 0)
    printf("staticIBM step=%d time=%.8e slipMax=%.8e slipRms=%.8e "
           "force=(%.8e, %.8e, %.8e)\n",
           tstep,
           time,
           static_cast<double>(values.maximumSlip),
           static_cast<double>(values.rmsSlip),
           static_cast<double>(values.force[0]),
           static_cast<double>(values.force[1]),
           static_cast<double>(values.force[2]));

  if (staticIbm.ciMode() == 0)
    return;

  const auto & markers = staticIbm.markers();
  const std::size_t expectedCount = staticIbm.ciMode() == 1 ? 16 : 64;
  CiEvalTest("IBM marker arrays are finite and identical on every rank",
             staticIbm.broadcastValidationPassed());
  CiEvalTest("IBM deterministic reference marker count (" +
                 std::to_string(markers.size()) + ")",
             markers.size() == expectedCount);
  CiEvalTest("IBM marker volumes are positive",
             std::all_of(markers.volume.begin(), markers.volume.end(),
                         [](const dfloat value) { return std::isfinite(value) && value > 0; }));
  CiFinalize();
}

#endif
